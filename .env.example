# JARVIS 2 · Nivel 1 · VOZ
# Todo el cerebro funciona localmente con Ollama.
# No necesitas una API key de OpenAI.

JARVIS_LLM_MODEL=llama3.2
OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_STT_MODEL=base
JARVIS_TTS_VOICE=es_MX-ald-medium
JARVIS_VOICES_DIR=voices
JARVIS_SAMPLE_RATE=16000
JARVIS_CHANNELS=1
JARVIS_MAX_RECORD_SECONDS=30
